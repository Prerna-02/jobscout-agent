# Copy to .env and fill in. Never commit .env.

# --- LLM (Phase 1+) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SECOND_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional last-resort fallback: any OpenRouter model id ending in ":free"
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Langfuse tracing (optional; tracing is off when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region of your Langfuse project:
# US https://us.cloud.langfuse.com   EU https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
APP_ENV=dev

# --- Scoring (Phase 4) ---
# Claude scores the shortlist; without a key, scoring falls back to Gemini.
ANTHROPIC_API_KEY=
SCORER_MODEL=claude-sonnet-5
EMBEDDING_MODEL=gemini-embedding-2
TRUST_MODEL=claude-haiku-4-5

# --- Job search (Phase 2) ---
# JSearch key from OpenWeb Ninja (sent as the x-api-key header)
JSEARCH_API_KEY=
# Upstash: copy the "Redis URL" (rediss://default:<password>@<host>:6379), not the redis-cli command
REDIS_URL=

# --- Paused runs, presets, results (Phase 3) ---
# Postgres (e.g. Neon). Leave empty to save paused runs in backend/.jobscout/checkpoints.sqlite
DATABASE_URL=
