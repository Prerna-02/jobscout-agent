# Copy to .env and fill in. Never commit .env.

# --- LLM (Phase 1+) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional last-resort fallback: any OpenRouter model id ending in ":free"
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Langfuse tracing (optional; tracing is off when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
APP_ENV=dev

# --- Job search (Phase 2) ---
JSEARCH_API_KEY=
REDIS_URL=

# --- Paused runs, presets, results (Phase 3) ---
DATABASE_URL=
